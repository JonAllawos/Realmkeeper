/* Realmkeeper HUD: dark translucent panels, parchment text, muted gold accents. */

.rk-root {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
    padding: 10px;
    font-size: 14px;
    color: rgb(232, 223, 204);
}

.rk-panel {
    background-color: rgba(22, 20, 17, 0.84);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.28);
    border-radius: 6px;
}

.rk-grow {
    flex-grow: 1;
}

.rk-divider {
    width: 1px;
    height: 22px;
    margin: 0 10px;
    background-color: rgba(201, 164, 101, 0.3);
}

/* ----- Top bar -------------------------------------------------------------------- */

.rk-top-bar {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 12px;
}

.rk-wordmark {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(214, 180, 116);
}

.rk-world-name {
    -unity-font-style: bold;
    margin-right: 14px;
}

.rk-date {
    color: rgb(190, 181, 163);
}

.rk-button {
    height: 30px;
    min-width: 64px;
    margin: 0 3px;
    padding: 0 10px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(201, 164, 101, 0.35);
    background-color: rgba(60, 54, 45, 0.9);
    color: rgb(232, 223, 204);
}

.rk-button:hover {
    background-color: rgba(84, 75, 60, 0.95);
}

.rk-button:active {
    background-color: rgba(110, 96, 72, 1);
}

.rk-button--primary {
    min-width: 76px;
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(214, 180, 116, 0.6);
}

.rk-button--primary:hover {
    background-color: rgba(142, 110, 58, 1);
}

.rk-speed {
    margin: 0 6px 0 10px;
    min-width: 170px;
}

.rk-speed > Label {
    min-width: 50px;
    color: rgb(190, 181, 163);
}

.rk-speed .unity-base-popup-field__input {
    background-color: rgba(60, 54, 45, 0.9);
    border-color: rgba(201, 164, 101, 0.35);
    color: rgb(232, 223, 204);
}

/* ----- Middle: navigation and inspector ------------------------------------------- */

.rk-middle {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-start;
    margin: 10px 0;
}

.rk-nav {
    width: 210px;
    padding: 8px;
}

.rk-nav-item {
    height: 32px;
    margin: 1px 0;
    padding: 0 10px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    color: rgb(232, 223, 204);
    flex-direction: row;
    align-items: center;
}

.rk-nav-item:hover {
    background-color: rgba(84, 75, 60, 0.7);
}

.rk-nav-item--active {
    background-color: rgba(120, 92, 48, 0.55);
    color: rgb(240, 214, 160);
}

.rk-nav-item:disabled {
    color: rgb(120, 114, 102);
}

.rk-nav-later {
    flex-direction: column;
}

.rk-tag {
    margin-left: auto;
    padding: 1px 6px;
    font-size: 10px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(140, 133, 120);
}

.rk-nav-separator {
    height: 1px;
    margin: 8px 4px;
    background-color: rgba(201, 164, 101, 0.2);
}

.rk-settlement-list {
    max-height: 220px;
    margin: 2px 0 2px 10px;
}

.rk-settlement-item {
    height: 28px;
    margin: 1px 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    color: rgb(214, 205, 186);
    flex-direction: row;
    align-items: center;
}

.rk-settlement-item:hover {
    background-color: rgba(84, 75, 60, 0.7);
}

.rk-settlement-item--selected {
    background-color: rgba(120, 92, 48, 0.55);
    color: rgb(240, 214, 160);
}

.rk-settlement-type {
    margin-left: auto;
    font-size: 11px;
    color: rgb(150, 142, 126);
}

.rk-inspector {
    width: 310px;
    padding: 12px 14px;
}

.rk-inspector-header {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}

.rk-insp-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.rk-insp-type {
    color: rgb(170, 161, 144);
}

.rk-close {
    width: 26px;
    height: 26px;
    padding: 0;
    border-width: 0;
    border-radius: 4px;
    font-size: 16px;
    background-color: rgba(60, 54, 45, 0.9);
    color: rgb(214, 205, 186);
}

.rk-badge {
    align-self: flex-start;
    margin: 2px 0 8px 0;
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 12px;
    -unity-font-style: bold;
}

.rk-badge--critical {
    background-color: rgba(150, 52, 40, 0.9);
    color: rgb(255, 228, 214);
}

.rk-section {
    margin-top: 12px;
    margin-bottom: 4px;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(201, 164, 101);
}

.rk-section--first {
    margin-top: 0;
}

.rk-row {
    flex-direction: row;
    justify-content: space-between;
    margin: 2px 0;
}

.rk-key {
    color: rgb(170, 161, 144);
}

.rk-value {
    -unity-font-style: bold;
}

.rk-value--negative {
    color: rgb(232, 128, 104);
}

.rk-value--positive {
    color: rgb(160, 200, 120);
}

.rk-bar-label {
    margin-top: 6px;
}

.rk-bar {
    height: 16px;
    margin-top: 2px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.07);
    overflow: hidden;
}

.rk-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 50%;
}

.rk-bar-fill--prosperity {
    background-color: rgb(170, 138, 70);
}

.rk-bar-fill--stability {
    background-color: rgb(96, 128, 140);
}

.rk-bar-text {
    position: absolute;
    right: 6px;
    top: 0;
    bottom: 0;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: rgb(240, 232, 214);
}

.rk-resources {
    flex-direction: column;
}

/* ----- Bottom activity area -------------------------------------------------------- */

.rk-bottom {
    flex-direction: row;
    height: 168px;
    padding: 10px 14px;
}

.rk-activity {
    flex-grow: 1;
    margin-right: 16px;
}

.rk-events {
    flex-direction: column;
}

.rk-event {
    flex-direction: row;
    margin: 1px 0;
}

.rk-event-date {
    width: 170px;
    color: rgb(150, 142, 126);
}

.rk-event-text {
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rk-sev-info .rk-event-text {
    color: rgb(214, 205, 186);
}

.rk-sev-warning .rk-event-text {
    color: rgb(230, 190, 100);
}

.rk-sev-positive .rk-event-text {
    color: rgb(170, 206, 132);
}

.rk-sev-critical .rk-event-text {
    color: rgb(236, 120, 96);
}

.rk-sim {
    width: 260px;
    padding-left: 14px;
    border-left-width: 1px;
    border-color: rgba(201, 164, 101, 0.2);
}

.rk-sim-state {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.rk-sim-state--playing {
    color: rgb(160, 200, 120);
}

.rk-sim-line {
    color: rgb(190, 181, 163);
}

.rk-message {
    margin-top: 8px;
    white-space: normal;
    color: rgb(214, 180, 116);
}

.rk-message--error {
    color: rgb(236, 120, 96);
}

/* ----- Phase 2 inspector: status, warnings, economy table, trade ----------------------- */

.rk-inspector {
    max-height: 100%;
}

/* Top bar and bottom panel keep their size; the middle row absorbs any shortage of space. */
.rk-top-bar,
.rk-bottom {
    flex-shrink: 0;
}

.rk-middle {
    min-height: 0;
    overflow: hidden;
}

/* Only the scrolling body may shrink; everything above it keeps its height. */
.rk-inspector > * {
    flex-shrink: 0;
}

.rk-inspector > .rk-insp-body {
    flex-shrink: 1;
}

/* Bottom panel: rows keep their height and extra rows are clipped, never overlapped. */
.rk-bottom Label,
.rk-event {
    flex-shrink: 0;
}

.rk-activity,
.rk-events,
.rk-sim {
    overflow: hidden;
}

.rk-badges {
    flex-direction: row;
    flex-wrap: wrap;
}

.rk-badges > .rk-badge {
    margin-right: 6px;
}

.rk-status {
    background-color: rgba(96, 128, 140, 0.85);
    color: rgb(236, 240, 242);
}

.rk-status--thriving {
    background-color: rgba(92, 128, 70, 0.9);
}

.rk-status--stable {
    background-color: rgba(96, 128, 140, 0.85);
}

.rk-status--strained {
    background-color: rgba(150, 118, 52, 0.9);
}

.rk-status--shortage,
.rk-status--starving {
    background-color: rgba(150, 52, 40, 0.9);
}

.rk-warnings {
    flex-direction: column;
    margin-bottom: 4px;
}

.rk-warning {
    margin: 1px 0;
    padding: 2px 6px;
    border-left-width: 3px;
    border-color: rgb(214, 120, 90);
    background-color: rgba(150, 52, 40, 0.25);
    color: rgb(244, 210, 196);
    font-size: 12px;
    white-space: normal;
}

.rk-trend {
    font-size: 11px;
    color: rgb(170, 161, 144);
}

.rk-trend--rising {
    color: rgb(160, 200, 120);
}

.rk-trend--falling {
    color: rgb(232, 128, 104);
}

.rk-table-head,
.rk-table-row {
    flex-direction: row;
    align-items: center;
}

.rk-table-head > Label {
    font-size: 10px;
    color: rgb(150, 142, 126);
}

.rk-table-row {
    margin: 1px 0;
    padding: 1px 2px;
    border-radius: 3px;
}

.rk-table-row--short {
    background-color: rgba(150, 52, 40, 0.3);
}

/* Columns sized to fit the inspector's content width (310 − padding − scrollbar ≈ 260).
   Labels carry default margins and padding, so table cells reset them. */
.rk-table-head > Label,
.rk-table-row > Label {
    margin: 0;
    padding: 0 1px;
    flex-shrink: 0;
}

.rk-col-name {
    width: 44px;
    color: rgb(214, 205, 186);
}

.rk-col-num {
    width: 35px;
    -unity-text-align: middle-right;
    font-size: 11px;
}

.rk-col-stock {
    width: 66px;
}

.rk-trade-line {
    font-size: 12px;
    white-space: normal;
    margin: 1px 0;
    color: rgb(214, 205, 186);
}

.rk-trade-line--blocked {
    color: rgb(230, 190, 100);
}

.rk-hidden {
    display: none;
}

/* ----- ADR-0009 vertical slice: region line and Enter settlement -------------------------- */

.rk-enter-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 6px 0;
}

.rk-insp-region {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: rgb(170, 161, 144);
}

.rk-enter {
    margin: 0;
}

/* ----- Phase 2 completion: reasons, route toggles ------------------------------------------ */

.rk-why {
    font-size: 11px;
    white-space: normal;
    margin: 1px 0 2px 0;
    color: rgb(170, 161, 144);
}

.rk-route-row {
    flex-direction: row;
    align-items: center;
}

.rk-route-row > .rk-trade-line {
    flex-grow: 1;
    flex-shrink: 1;
}

.rk-route-toggle {
    height: 20px;
    min-width: 0;
    margin: 0 0 0 4px;
    padding: 0 6px;
    font-size: 10px;
}

.rk-trade-line--suspended {
    color: rgb(150, 142, 126);
}

/* ----- Phase 3: factions and politics -------------------------------------------------------- */

.rk-faction-list {
    max-height: 260px;
}

.rk-faction-item {
    height: 38px;
    align-items: center;
}

.rk-faction-text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.rk-faction-name {
    margin: 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.rk-faction-detail {
    margin: 0;
    padding: 0;
    font-size: 10px;
    color: rgb(150, 142, 126);
    -unity-text-align: middle-left;
}

.rk-section-row {
    flex-direction: row;
    align-items: flex-end;
}

.rk-section-row > .rk-route-toggle {
    margin-bottom: 3px;
}

.rk-faction-row {
    align-items: center;
}

.rk-faction-key {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    overflow: hidden;
}

.rk-faction-row-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rk-faction-row:hover .rk-faction-row-name {
    color: rgb(240, 214, 160);
}

.rk-faction-row--waning .rk-faction-row-name {
    color: rgb(130, 124, 112);
}

.rk-row--contested > .rk-value {
    color: rgb(230, 190, 100);
}

.rk-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 0 4px 16px;
}

.rk-actions > .rk-route-toggle {
    margin: 1px 4px 1px 0;
}

#faction-inspector .rk-insp-name {
    white-space: normal;
    flex-shrink: 1;
}

#faction-inspector .rk-inspector-header > .rk-grow {
    flex-shrink: 1;
    min-width: 0;
}

.rk-faction-item--dissolved {
    color: rgb(120, 114, 102);
}

.rk-swatch {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
    flex-shrink: 0;
}

.rk-route-row {
    flex-wrap: wrap;
}

.rk-absent-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.rk-absent-row > .rk-route-toggle {
    margin: 1px 4px 1px 0;
}
