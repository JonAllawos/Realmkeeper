<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="RealmkeeperHud.uss" />
    <ui:VisualElement name="hud-root" class="rk-root" picking-mode="Ignore">

        <!-- Top bar: wordmark, world, date, time controls, speed, save/load -->
        <ui:VisualElement name="top-bar" class="rk-panel rk-top-bar">
            <ui:Label text="REALMKEEPER" class="rk-wordmark" />
            <ui:VisualElement class="rk-divider" />
            <ui:Label name="world-name" text="-" class="rk-world-name" />
            <ui:Label name="date" text="-" class="rk-date" />
            <ui:VisualElement class="rk-grow" picking-mode="Ignore" />
            <ui:Button name="play-pause" text="Play" class="rk-button rk-button--primary" />
            <ui:Button name="advance-day" text="+1 day" class="rk-button" />
            <ui:Button name="advance-week" text="+1 week" class="rk-button" />
            <ui:Button name="advance-month" text="+1 month" class="rk-button" />
            <ui:DropdownField name="speed" label="Speed" class="rk-speed" />
            <ui:Button name="toggle-politics" text="Politics" tooltip="Show or hide who governs each settlement on the map." class="rk-button" />
            <ui:VisualElement class="rk-divider" />
            <ui:Button name="save" text="Save" class="rk-button" />
            <ui:Button name="load" text="Load" class="rk-button" />
        </ui:VisualElement>

        <ui:VisualElement name="middle" class="rk-middle" picking-mode="Ignore">

            <!-- Left navigation -->
            <ui:VisualElement name="nav" class="rk-panel rk-nav">
                <ui:Button name="nav-world" text="World" class="rk-nav-item rk-nav-item--active" />
                <ui:Button name="nav-settlements" text="Settlements" class="rk-nav-item" />
                <ui:ScrollView name="settlement-list" class="rk-settlement-list" />
                <ui:Button name="nav-factions" text="Factions" class="rk-nav-item" />
                <ui:ScrollView name="faction-list" class="rk-settlement-list rk-faction-list" />
                <ui:Button name="nav-people" text="People" tooltip="Named people: filter, inspect, and (as DM) edit them." class="rk-nav-item" />
                <ui:VisualElement name="people-panel" class="rk-people-panel rk-hidden" />
                <ui:VisualElement class="rk-nav-separator" />
                <ui:VisualElement name="nav-later" class="rk-nav-later" />
            </ui:VisualElement>

            <ui:VisualElement class="rk-grow" picking-mode="Ignore" />

            <!-- Right inspector -->
            <ui:VisualElement name="inspector" class="rk-panel rk-inspector">
                <ui:VisualElement class="rk-inspector-header">
                    <ui:VisualElement class="rk-grow">
                        <ui:Label name="insp-name" text="-" class="rk-insp-name" />
                        <ui:Label name="insp-type" text="-" class="rk-insp-type" />
                    </ui:VisualElement>
                    <ui:Button name="insp-close" text="×" class="rk-close" />
                </ui:VisualElement>
                <ui:VisualElement class="rk-badges">
                    <ui:Label name="insp-status" text="Stable" class="rk-badge rk-status" />
                    <ui:Label name="insp-shortage" text="Food shortage" class="rk-badge rk-badge--critical" />
                </ui:VisualElement>
                <ui:VisualElement name="insp-warnings" class="rk-warnings" />
                <ui:VisualElement class="rk-enter-row">
                    <ui:Label name="insp-region" text="-" class="rk-insp-region" />
                    <ui:Button name="insp-enter" text="Enter settlement" class="rk-button rk-button--primary rk-enter" />
                    <ui:Button name="insp-country" text="Walk the country" tooltip="Go out into the country around this settlement and walk it (Phase 23)." class="rk-button rk-enter" />
                </ui:VisualElement>

                <ui:ScrollView name="insp-body" class="rk-insp-body" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement class="rk-row">
                        <ui:Label text="Population" class="rk-key" />
                        <ui:Label name="insp-population" text="-" class="rk-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rk-row">
                        <ui:Label text="Workers" class="rk-key" />
                        <ui:Label name="insp-workers" text="-" class="rk-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rk-row">
                        <ui:Label text="Faction" class="rk-key" />
                        <ui:Label name="insp-faction" text="-" class="rk-value" />
                    </ui:VisualElement>

                    <ui:VisualElement class="rk-row rk-bar-label">
                        <ui:Label text="Prosperity" class="rk-key" />
                        <ui:Label name="insp-prosperity-trend" text="-" class="rk-trend" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rk-bar">
                        <ui:VisualElement name="insp-prosperity-fill" class="rk-bar-fill rk-bar-fill--prosperity" />
                        <ui:Label name="insp-prosperity" text="-" class="rk-bar-text" />
                    </ui:VisualElement>
                    <ui:Label name="insp-prosperity-why" text="" class="rk-why" />
                    <ui:VisualElement class="rk-row rk-bar-label">
                        <ui:Label text="Stability" class="rk-key" />
                        <ui:Label name="insp-stability-trend" text="-" class="rk-trend" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rk-bar">
                        <ui:VisualElement name="insp-stability-fill" class="rk-bar-fill rk-bar-fill--stability" />
                        <ui:Label name="insp-stability" text="-" class="rk-bar-text" />
                    </ui:VisualElement>
                    <ui:Label name="insp-stability-why" text="" class="rk-why" />

                    <ui:Label text="Food" class="rk-section" />
                    <ui:VisualElement class="rk-row">
                        <ui:Label text="Reserves" class="rk-key" />
                        <ui:Label name="insp-food" text="-" class="rk-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rk-row">
                        <ui:Label text="Produced per day" class="rk-key" />
                        <ui:Label name="insp-food-produced" text="-" class="rk-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rk-row">
                        <ui:Label text="Eaten per day" class="rk-key" />
                        <ui:Label name="insp-food-consumed" text="-" class="rk-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rk-row">
                        <ui:Label text="Net (own farms)" class="rk-key" />
                        <ui:Label name="insp-food-net" text="-" class="rk-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rk-row">
                        <ui:Label text="Days remaining" class="rk-key" />
                        <ui:Label name="insp-food-days" text="-" class="rk-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rk-row">
                        <ui:Label text="Reserves trend" class="rk-key" />
                        <ui:Label name="insp-food-trend" text="-" class="rk-value" />
                    </ui:VisualElement>

                    <ui:Label text="Economy (last day)" class="rk-section" />
                    <ui:VisualElement class="rk-table-head">
                        <ui:Label text="" class="rk-col-name" />
                        <ui:Label text="Stock" class="rk-col-num rk-col-stock" />
                        <ui:Label text="Made" class="rk-col-num" />
                        <ui:Label text="Used" class="rk-col-num" />
                        <ui:Label text="Trade" class="rk-col-num" />
                        <ui:Label text="Net" class="rk-col-num" />
                    </ui:VisualElement>
                    <ui:VisualElement name="insp-economy" class="rk-table" />

                    <ui:Label text="Production" class="rk-section" />
                    <ui:VisualElement name="insp-production" class="rk-resources" />

                    <ui:Label text="Trade routes" class="rk-section" />
                    <ui:VisualElement name="insp-trade" class="rk-resources" />

                    <ui:Label text="Residents" class="rk-section" tooltip="Named people who live here. Click one to inspect them." />
                    <ui:VisualElement name="insp-residents" class="rk-resources" />

                    <ui:Label text="Structures" class="rk-section" tooltip="The settlement's buildings. Functional ones take part in the simulation (homes, shops, workplaces, gathering places); informational ones are named and described but simulate nothing yet; decorative ones are scenery." />
                    <ui:VisualElement name="insp-structures" class="rk-resources" />

                    <ui:VisualElement class="rk-section-row">
                        <ui:Label text="Politics" class="rk-section rk-grow" />
                        <ui:Button name="insp-politics-manage" text="Manage" tooltip="Show the political actions you can take here." class="rk-button rk-route-toggle" />
                    </ui:VisualElement>
                    <ui:VisualElement name="insp-politics" class="rk-resources" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- Faction inspector (shown instead of the settlement inspector) -->
            <ui:VisualElement name="faction-inspector" class="rk-panel rk-inspector rk-hidden">
                <ui:VisualElement class="rk-inspector-header">
                    <ui:VisualElement class="rk-grow">
                        <ui:Label name="finsp-name" text="-" class="rk-insp-name" />
                        <ui:Label name="finsp-type" text="-" class="rk-insp-type" />
                    </ui:VisualElement>
                    <ui:Button name="finsp-close" text="×" class="rk-close" />
                </ui:VisualElement>
                <ui:ScrollView name="finsp-body" class="rk-insp-body" mode="Vertical" horizontal-scroller-visibility="Hidden" />
            </ui:VisualElement>

            <!-- NPC inspector (shown instead of the other inspectors) -->
            <ui:VisualElement name="npc-inspector" class="rk-panel rk-inspector rk-hidden">
                <ui:VisualElement class="rk-inspector-header">
                    <ui:VisualElement class="rk-grow">
                        <ui:Label name="ninsp-name" text="-" class="rk-insp-name" />
                        <ui:Label name="ninsp-type" text="-" class="rk-insp-type" />
                    </ui:VisualElement>
                    <ui:Button name="ninsp-manage" text="Manage" tooltip="Show the DM's tools for this person." class="rk-button rk-route-toggle" />
                    <ui:Button name="ninsp-close" text="×" class="rk-close" />
                </ui:VisualElement>
                <ui:ScrollView name="ninsp-body" class="rk-insp-body" mode="Vertical" horizontal-scroller-visibility="Hidden" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom activity area -->
        <ui:VisualElement name="bottom" class="rk-panel rk-bottom">
            <ui:VisualElement class="rk-activity">
                <ui:Label text="Recent events" class="rk-section rk-section--first" />
                <ui:VisualElement name="event-list" class="rk-events" />
            </ui:VisualElement>
            <ui:VisualElement class="rk-sim">
                <ui:Label text="Simulation" class="rk-section rk-section--first" />
                <ui:Label name="sim-state" text="Paused" class="rk-sim-state" />
                <ui:Label name="sim-speed" text="-" class="rk-sim-line" />
                <ui:Label name="sim-days" text="-" class="rk-sim-line" />
                <ui:Label name="message" text="" class="rk-message" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
