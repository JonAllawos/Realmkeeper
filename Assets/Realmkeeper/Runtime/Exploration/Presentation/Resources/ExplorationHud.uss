/* Exploration HUD: same palette as the strategic HUD (dark translucent panels, parchment text, muted gold). */

.xk-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 12px;
    font-size: 14px;
    color: rgb(232, 223, 204);
}

.xk-panel {
    background-color: rgba(22, 20, 17, 0.84);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.28);
    border-radius: 6px;
}

.xk-grow {
    flex-grow: 1;
}

.xk-hidden {
    display: none;
}

.xk-top {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.xk-location {
    padding: 8px 14px;
}

.xk-settlement {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-region {
    color: rgb(190, 181, 163);
}

.xk-date {
    font-size: 12px;
    color: rgb(150, 142, 126);
}

.xk-actions {
    flex-direction: row;
    align-items: center;
    height: 46px;
    padding: 0 10px;
}

.xk-perspective {
    -unity-font-style: bold;
    color: rgb(214, 180, 116);
    margin: 0 4px;
}

.xk-divider {
    width: 1px;
    height: 22px;
    margin: 0 10px;
    background-color: rgba(201, 164, 101, 0.3);
}

.xk-button {
    height: 30px;
    margin: 0 3px;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(201, 164, 101, 0.35);
    background-color: rgba(60, 54, 45, 0.9);
    color: rgb(232, 223, 204);
}

.xk-button:hover {
    background-color: rgba(84, 75, 60, 0.95);
}

.xk-button--primary {
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(214, 180, 116, 0.6);
}

.xk-button--primary:hover {
    background-color: rgba(142, 110, 58, 1);
}

.xk-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
    border-radius: 3px;
    background-color: rgba(240, 232, 214, 0.8);
}

.xk-bottom {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.xk-response {
    width: 640px;
    max-width: 90%;
    padding: 10px 14px;
    margin-bottom: 10px;
}

.xk-response-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.xk-response-title {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-response-text {
    white-space: normal;
}

.xk-response--failed .xk-response-text {
    color: rgb(236, 120, 96);
}

.xk-prompt {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    margin-bottom: 8px;
}

.xk-key {
    min-width: 22px;
    height: 22px;
    margin-right: 8px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(214, 180, 116, 0.7);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-prompt-text {
    margin-right: 10px;
}

/* Informational interactions only read the world; state-changing ones are recorded in it. */
.xk-kind {
    padding: 1px 6px;
    font-size: 10px;
    border-radius: 3px;
    background-color: rgba(96, 128, 140, 0.85);
    color: rgb(236, 240, 242);
}

.xk-kind--changes {
    background-color: rgba(150, 118, 52, 0.95);
}

.xk-message {
    color: rgb(214, 180, 116);
    margin-bottom: 4px;
}

.xk-message--error {
    color: rgb(236, 120, 96);
}

.xk-help {
    font-size: 11px;
    color: rgba(232, 223, 204, 0.75);
    background-color: rgba(22, 20, 17, 0.6);
    padding: 2px 8px;
    border-radius: 3px;
}

/* Phase 4: conversation topics */
.xk-topics {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.xk-topic {
    margin: 2px 4px 2px 0;
    padding: 2px 8px;
    font-size: 12px;
}
