/* Exploration HUD: same palette as the strategic HUD (dark translucent panels, parchment text, muted gold). */

.xk-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 12px;
    font-size: 14px;
    color: rgb(232, 223, 204);
}

.xk-panel {
    background-color: rgba(22, 20, 17, 0.84);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.28);
    border-radius: 6px;
}

.xk-grow {
    flex-grow: 1;
}

.xk-hidden {
    display: none;
}

.xk-top {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.xk-location {
    padding: 8px 14px;
}

.xk-settlement {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-region {
    color: rgb(190, 181, 163);
}

.xk-date {
    font-size: 12px;
    color: rgb(150, 142, 126);
}

.xk-actions {
    flex-direction: row;
    align-items: center;
    height: 46px;
    padding: 0 10px;
}

.xk-perspective {
    -unity-font-style: bold;
    color: rgb(214, 180, 116);
    margin: 0 4px;
}

.xk-divider {
    width: 1px;
    height: 22px;
    margin: 0 10px;
    background-color: rgba(201, 164, 101, 0.3);
}

.xk-button {
    height: 30px;
    margin: 0 3px;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(201, 164, 101, 0.35);
    background-color: rgba(60, 54, 45, 0.9);
    color: rgb(232, 223, 204);
}

.xk-button:hover {
    background-color: rgba(84, 75, 60, 0.95);
}

.xk-button--primary {
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(214, 180, 116, 0.6);
}

.xk-button--primary:hover {
    background-color: rgba(142, 110, 58, 1);
}

.xk-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
    border-radius: 3px;
    background-color: rgba(240, 232, 214, 0.8);
}

.xk-bottom {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.xk-response {
    width: 640px;
    max-width: 90%;
    padding: 10px 14px;
    margin-bottom: 10px;
}

.xk-response-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.xk-response-title {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-response-text {
    white-space: normal;
}

.xk-response--failed .xk-response-text {
    color: rgb(236, 120, 96);
}

.xk-prompt {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    margin-bottom: 8px;
}

.xk-key {
    min-width: 22px;
    height: 22px;
    margin-right: 8px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(214, 180, 116, 0.7);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-prompt-text {
    margin-right: 10px;
}

/* Informational interactions only read the world; state-changing ones are recorded in it. */
.xk-kind {
    padding: 1px 6px;
    font-size: 10px;
    border-radius: 3px;
    background-color: rgba(96, 128, 140, 0.85);
    color: rgb(236, 240, 242);
}

.xk-kind--changes {
    background-color: rgba(150, 118, 52, 0.95);
}

.xk-message {
    color: rgb(214, 180, 116);
    margin-bottom: 4px;
}

.xk-message--error {
    color: rgb(236, 120, 96);
}

.xk-help {
    font-size: 11px;
    color: rgba(232, 223, 204, 0.75);
    background-color: rgba(22, 20, 17, 0.6);
    padding: 2px 8px;
    border-radius: 3px;
}

/* Phase 4: conversation topics */
.xk-topics {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.xk-topic {
    margin: 2px 4px 2px 0;
    padding: 2px 8px;
    font-size: 12px;
}

/* Phase 5: clock and time controls */
.xk-clock-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.xk-clock {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
    margin-right: 8px;
    min-width: 150px;
}

.xk-time-button {
    height: 24px;
    padding: 0 8px;
    font-size: 12px;
}

/* Phase 5: game windows (trade, player hub) */
.xk-window {
    position: absolute;
    background-color: rgba(18, 16, 13, 0.985);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.55);
    border-radius: 8px;
    padding: 14px 18px;
    color: rgb(232, 223, 204);
}

.xk-trade {
    left: 12%;
    right: 12%;
    top: 9%;
    bottom: 9%;
}

.xk-hub {
    left: 5%;
    right: 5%;
    top: 6%;
    bottom: 6%;
}

.xk-w-head {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-color: rgba(201, 164, 101, 0.3);
    padding-bottom: 8px;
    margin-bottom: 8px;
}

.xk-w-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-w-subtitle {
    color: rgb(190, 181, 163);
}

.xk-w-purse {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(226, 196, 120);
    margin: 0 14px;
}

.xk-w-status {
    padding: 4px 8px;
    margin-bottom: 8px;
    border-radius: 4px;
    background-color: rgba(70, 96, 64, 0.6);
}

.xk-w-status--closed {
    background-color: rgba(120, 56, 44, 0.7);
}

.xk-w-columns {
    flex-grow: 1;
    flex-direction: row;
}

.xk-w-col {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 10px;
}

.xk-w-heading {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(214, 180, 116);
    margin: 6px 0 4px 0;
}

.xk-w-list {
    flex-grow: 1;
    background-color: rgba(34, 31, 26, 0.7);
    border-radius: 4px;
}

.xk-w-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-color: rgba(201, 164, 101, 0.12);
}

.xk-w-row:hover {
    background-color: rgba(84, 75, 60, 0.45);
}

.xk-w-row--selected {
    background-color: rgba(120, 92, 48, 0.4);
}

.xk-w-row--refused .xk-w-name {
    color: rgb(150, 142, 126);
}

.xk-w-row--worn {
    background-color: rgba(70, 96, 64, 0.35);
}

.xk-w-name {
    flex-grow: 1;
}

.xk-w-faint {
    color: rgb(150, 142, 126);
}

.xk-w-qty {
    width: 44px;
    color: rgb(190, 181, 163);
}

.xk-w-price {
    width: 120px;
    -unity-text-align: middle-right;
    color: rgb(226, 196, 120);
    margin-right: 8px;
}

.xk-w-slot {
    width: 110px;
    -unity-font-style: bold;
    color: rgb(214, 180, 116);
}

.xk-w-act {
    height: 24px;
    padding: 0 8px;
    font-size: 12px;
}

.xk-w-detail {
    white-space: normal;
    margin-top: 8px;
    padding: 6px 8px;
    background-color: rgba(34, 31, 26, 0.7);
    border-radius: 4px;
    min-height: 40px;
}

.xk-w-message {
    margin-top: 6px;
    color: rgb(214, 180, 116);
}

.xk-w-ledger-line {
    font-size: 12px;
    color: rgb(190, 181, 163);
}

.xk-w-empty {
    color: rgb(150, 142, 126);
    padding: 6px;
}

.xk-w-note {
    white-space: normal;
    font-size: 12px;
    color: rgb(190, 181, 163);
    margin: 6px 0;
}

.xk-w-desc {
    white-space: normal;
    font-size: 11px;
    color: rgb(150, 142, 126);
    margin: 0 6px 4px 6px;
}

.xk-w-pair {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
}

.xk-w-key {
    width: 170px;
    -unity-font-style: bold;
    color: rgb(214, 180, 116);
}

.xk-w-value {
    flex-grow: 1;
    white-space: normal;
}

.xk-w-choice {
    height: 26px;
}

.xk-w-choice--on {
    background-color: rgba(142, 110, 58, 1);
    border-color: rgba(240, 214, 160, 0.9);
}

.xk-w-swatch {
    width: 30px;
    height: 26px;
    margin: 0 4px;
    border-width: 2px;
    border-radius: 4px;
    border-color: rgba(0, 0, 0, 0.5);
}

.xk-w-swatch--on {
    border-color: rgb(240, 214, 160);
}

.xk-hub-body {
    flex-grow: 1;
    flex-direction: row;
}

.xk-hub-nav {
    width: 210px;
    margin-right: 12px;
}

.xk-hub-tab {
    height: 38px;
    margin: 2px 0;
    -unity-text-align: middle-left;
    padding-left: 12px;
    font-size: 14px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(201, 164, 101, 0.2);
    background-color: rgba(44, 40, 33, 0.9);
    color: rgb(222, 212, 192);
}

.xk-hub-tab:hover {
    background-color: rgba(84, 75, 60, 0.95);
}

.xk-hub-tab--active {
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(240, 214, 160, 0.7);
    color: rgb(250, 236, 206);
    -unity-font-style: bold;
}

.xk-hub-content {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgba(34, 31, 26, 0.7);
    border-radius: 4px;
    padding: 8px 12px;
}

.xk-hub-preview {
    width: 400px;
    margin-left: 12px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(201, 164, 101, 0.35);
    background-color: rgb(28, 25, 22);
    -unity-background-scale-mode: scale-and-crop;
    justify-content: flex-end;
    align-items: center;
}

.xk-hub-preview-hint {
    font-size: 11px;
    color: rgba(232, 223, 204, 0.7);
    margin-bottom: 6px;
}

.xk-hub-field {
    margin: 3px 0;
}

/* Phase 6: character creator and character sheet */
.xk-creator {
    left: 4%;
    right: 4%;
    top: 5%;
    bottom: 5%;
}

.xk-cc-steps {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.xk-cc-step {
    height: 30px;
    margin: 0 4px 4px 0;
    padding: 0 10px;
    font-size: 13px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(201, 164, 101, 0.2);
    background-color: rgba(44, 40, 33, 0.9);
    color: rgb(190, 181, 163);
}

.xk-cc-step--done {
    color: rgb(170, 210, 150);
    border-color: rgba(150, 190, 120, 0.45);
}

.xk-cc-step--active {
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(240, 214, 160, 0.8);
    color: rgb(250, 236, 206);
    -unity-font-style: bold;
}

.xk-cc-side {
    width: 380px;
    margin-left: 12px;
}

.xk-cc-preview {
    flex-grow: 1;
    width: 380px;
    margin-left: 0;
    justify-content: space-between;
}

.xk-cc-placeholder {
    margin-top: 8px;
    padding: 2px 8px;
    font-size: 11px;
    border-radius: 3px;
    background-color: rgba(150, 118, 52, 0.85);
    color: rgb(250, 240, 220);
}

.xk-cc-summary {
    margin-top: 8px;
    padding: 8px 10px;
    white-space: normal;
    background-color: rgba(34, 31, 26, 0.85);
    border-radius: 4px;
    color: rgb(226, 214, 190);
}

.xk-cc-foot {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: rgba(201, 164, 101, 0.3);
}

.xk-cc-problems {
    white-space: normal;
    color: rgb(170, 210, 150);
    margin-right: 10px;
}

.xk-cc-split {
    flex-direction: row;
}

.xk-cc-picker {
    width: 200px;
    margin-right: 12px;
}

.xk-cc-pick {
    height: 30px;
    margin: 2px 0;
    -unity-text-align: middle-left;
    padding-left: 10px;
}

.xk-cc-pick--on {
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(240, 214, 160, 0.8);
    -unity-font-style: bold;
}

.xk-cc-detail {
    flex-grow: 1;
    flex-basis: 0;
}

.xk-cc-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
    white-space: normal;
}

.xk-cc-source {
    font-size: 11px;
    color: rgb(150, 142, 126);
    margin-bottom: 4px;
}

.xk-cc-warn {
    white-space: normal;
    font-size: 12px;
    padding: 4px 8px;
    margin: 4px 0;
    border-radius: 3px;
    background-color: rgba(120, 90, 40, 0.45);
    color: rgb(240, 214, 160);
}

.xk-cc-col {
    width: 110px;
}

.xk-cc-choice {
    margin-top: 8px;
}

.xk-cc-wrap {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
}

.xk-cc-banner {
    padding: 10px 12px;
    margin-bottom: 10px;
    border-radius: 6px;
    background-color: rgba(120, 92, 48, 0.35);
    border-width: 1px;
    border-color: rgba(214, 180, 116, 0.5);
}

.xk-cc-card {
    width: 120px;
    margin: 0 8px 8px 0;
    padding: 8px;
    align-items: center;
    border-radius: 6px;
    background-color: rgba(44, 40, 33, 0.95);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.35);
}

.xk-cc-card-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-cc-card-label {
    font-size: 11px;
    color: rgb(190, 181, 163);
}

/* Phase 7: experience bar */
.xk-xp-track {
    height: 10px;
    margin-top: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.45);
}

.xk-xp-fill {
    height: 100%;
    background-color: rgb(201, 164, 101);
    border-radius: 4px;
}

/* Phase 7: key/value rows wrap instead of overflowing */
.xk-w-pair > .xk-w-key {
    white-space: normal;
    flex-shrink: 0;
}

.xk-w-pair > .xk-w-value {
    flex-basis: 0;
    flex-shrink: 1;
}
