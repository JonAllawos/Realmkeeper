/* Exploration HUD: same palette as the strategic HUD (dark translucent panels, parchment text, muted gold). */

.xk-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 12px;
    font-size: 14px;
    color: rgb(232, 223, 204);
}

.xk-panel {
    background-color: rgba(22, 20, 17, 0.84);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.28);
    border-radius: 6px;
}

.xk-grow {
    flex-grow: 1;
}

.xk-hidden {
    display: none;
}

.xk-top {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.xk-location {
    padding: 8px 14px;
}

.xk-settlement {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-region {
    color: rgb(190, 181, 163);
}

.xk-date {
    font-size: 12px;
    color: rgb(150, 142, 126);
}

.xk-actions {
    flex-direction: row;
    align-items: center;
    height: 46px;
    padding: 0 10px;
}

.xk-perspective {
    -unity-font-style: bold;
    color: rgb(214, 180, 116);
    margin: 0 4px;
}

.xk-divider {
    width: 1px;
    height: 22px;
    margin: 0 10px;
    background-color: rgba(201, 164, 101, 0.3);
}

.xk-button {
    height: 30px;
    margin: 0 3px;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(201, 164, 101, 0.35);
    background-color: rgba(60, 54, 45, 0.9);
    color: rgb(232, 223, 204);
}

.xk-button:hover {
    background-color: rgba(84, 75, 60, 0.95);
}

.xk-button--primary {
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(214, 180, 116, 0.6);
}

.xk-button--primary:hover {
    background-color: rgba(142, 110, 58, 1);
}

.xk-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
    border-radius: 3px;
    background-color: rgba(240, 232, 214, 0.8);
}

.xk-bottom {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.xk-response {
    width: 640px;
    max-width: 90%;
    padding: 10px 14px;
    margin-bottom: 10px;
}

.xk-response-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.xk-response-title {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-response-text {
    white-space: normal;
}

.xk-response--failed .xk-response-text {
    color: rgb(236, 120, 96);
}

.xk-prompt {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    margin-bottom: 8px;
}

.xk-key {
    min-width: 22px;
    height: 22px;
    margin-right: 8px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(214, 180, 116, 0.7);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-prompt-text {
    margin-right: 10px;
}

/* Informational interactions only read the world; state-changing ones are recorded in it. */
.xk-kind {
    padding: 1px 6px;
    font-size: 10px;
    border-radius: 3px;
    background-color: rgba(96, 128, 140, 0.85);
    color: rgb(236, 240, 242);
}

.xk-kind--changes {
    background-color: rgba(150, 118, 52, 0.95);
}

.xk-message {
    color: rgb(214, 180, 116);
    margin-bottom: 4px;
}

.xk-message--error {
    color: rgb(236, 120, 96);
}

.xk-help {
    font-size: 11px;
    color: rgba(232, 223, 204, 0.75);
    background-color: rgba(22, 20, 17, 0.6);
    padding: 2px 8px;
    border-radius: 3px;
}

/* Phase 4: conversation topics */
.xk-topics {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.xk-topic {
    margin: 2px 4px 2px 0;
    padding: 2px 8px;
    font-size: 12px;
}

/* Phase 5: clock and time controls */
.xk-clock-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.xk-clock {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
    margin-right: 8px;
    min-width: 150px;
}

.xk-time-button {
    height: 24px;
    padding: 0 8px;
    font-size: 12px;
}

/* Phase 5: game windows (trade, player hub) */
.xk-window {
    position: absolute;
    background-color: rgba(18, 16, 13, 0.985);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.55);
    border-radius: 8px;
    padding: 14px 18px;
    color: rgb(232, 223, 204);
}

.xk-trade {
    left: 12%;
    right: 12%;
    top: 9%;
    bottom: 9%;
}

.xk-hub {
    left: 5%;
    right: 5%;
    top: 6%;
    bottom: 6%;
}

.xk-w-head {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-color: rgba(201, 164, 101, 0.3);
    padding-bottom: 8px;
    margin-bottom: 8px;
}

.xk-w-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-w-subtitle {
    color: rgb(190, 181, 163);
}

.xk-w-purse {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(226, 196, 120);
    margin: 0 14px;
}

.xk-w-status {
    padding: 4px 8px;
    margin-bottom: 8px;
    border-radius: 4px;
    background-color: rgba(70, 96, 64, 0.6);
}

.xk-w-status--closed {
    background-color: rgba(120, 56, 44, 0.7);
}

.xk-w-columns {
    flex-grow: 1;
    flex-direction: row;
}

.xk-w-col {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 10px;
}

.xk-w-heading {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(214, 180, 116);
    margin: 6px 0 4px 0;
}

.xk-w-list {
    flex-grow: 1;
    background-color: rgba(34, 31, 26, 0.7);
    border-radius: 4px;
}

.xk-w-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-color: rgba(201, 164, 101, 0.12);
}

.xk-w-row:hover {
    background-color: rgba(84, 75, 60, 0.45);
}

.xk-w-row--selected {
    background-color: rgba(120, 92, 48, 0.4);
}

.xk-w-row--refused .xk-w-name {
    color: rgb(150, 142, 126);
}

.xk-w-row--worn {
    background-color: rgba(70, 96, 64, 0.35);
}

.xk-w-name {
    flex-grow: 1;
}

.xk-w-faint {
    color: rgb(150, 142, 126);
}

.xk-w-qty {
    width: 44px;
    color: rgb(190, 181, 163);
}

.xk-w-price {
    width: 120px;
    -unity-text-align: middle-right;
    color: rgb(226, 196, 120);
    margin-right: 8px;
}

.xk-w-slot {
    width: 110px;
    -unity-font-style: bold;
    color: rgb(214, 180, 116);
}

.xk-w-act {
    height: 24px;
    padding: 0 8px;
    font-size: 12px;
}

.xk-w-detail {
    white-space: normal;
    margin-top: 8px;
    padding: 6px 8px;
    background-color: rgba(34, 31, 26, 0.7);
    border-radius: 4px;
    min-height: 40px;
}

.xk-w-message {
    margin-top: 6px;
    color: rgb(214, 180, 116);
}

.xk-w-ledger-line {
    font-size: 12px;
    color: rgb(190, 181, 163);
}

.xk-w-empty {
    color: rgb(150, 142, 126);
    padding: 6px;
}

.xk-w-note {
    white-space: normal;
    font-size: 12px;
    color: rgb(190, 181, 163);
    margin: 6px 0;
}

.xk-w-desc {
    white-space: normal;
    font-size: 11px;
    color: rgb(150, 142, 126);
    margin: 0 6px 4px 6px;
}

.xk-w-pair {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
}

.xk-w-key {
    width: 170px;
    -unity-font-style: bold;
    color: rgb(214, 180, 116);
}

.xk-w-value {
    flex-grow: 1;
    white-space: normal;
}

.xk-w-choice {
    height: 26px;
}

.xk-w-choice--on {
    background-color: rgba(142, 110, 58, 1);
    border-color: rgba(240, 214, 160, 0.9);
}

.xk-w-swatch {
    width: 30px;
    height: 26px;
    margin: 0 4px;
    border-width: 2px;
    border-radius: 4px;
    border-color: rgba(0, 0, 0, 0.5);
}

.xk-w-swatch--on {
    border-color: rgb(240, 214, 160);
}

.xk-hub-body {
    flex-grow: 1;
    flex-direction: row;
}

.xk-hub-nav {
    width: 210px;
    margin-right: 12px;
}

.xk-hub-tab {
    height: 38px;
    margin: 2px 0;
    -unity-text-align: middle-left;
    padding-left: 12px;
    font-size: 14px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(201, 164, 101, 0.2);
    background-color: rgba(44, 40, 33, 0.9);
    color: rgb(222, 212, 192);
}

.xk-hub-tab:hover {
    background-color: rgba(84, 75, 60, 0.95);
}

.xk-hub-tab--active {
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(240, 214, 160, 0.7);
    color: rgb(250, 236, 206);
    -unity-font-style: bold;
}

.xk-hub-content {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgba(34, 31, 26, 0.7);
    border-radius: 4px;
    padding: 8px 12px;
}

.xk-hub-preview {
    width: 400px;
    margin-left: 12px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(201, 164, 101, 0.35);
    background-color: rgb(28, 25, 22);
    -unity-background-scale-mode: scale-and-crop;
    justify-content: flex-end;
    align-items: center;
}

.xk-hub-preview-hint {
    font-size: 11px;
    color: rgba(232, 223, 204, 0.7);
    margin-bottom: 6px;
}

.xk-hub-field {
    margin: 3px 0;
}

/* Phase 6: character creator and character sheet */
.xk-creator {
    left: 4%;
    right: 4%;
    top: 5%;
    bottom: 5%;
}

.xk-cc-steps {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.xk-cc-step {
    height: 30px;
    margin: 0 4px 4px 0;
    padding: 0 10px;
    font-size: 13px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(201, 164, 101, 0.2);
    background-color: rgba(44, 40, 33, 0.9);
    color: rgb(190, 181, 163);
}

.xk-cc-step--done {
    color: rgb(170, 210, 150);
    border-color: rgba(150, 190, 120, 0.45);
}

.xk-cc-step--active {
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(240, 214, 160, 0.8);
    color: rgb(250, 236, 206);
    -unity-font-style: bold;
}

.xk-cc-side {
    width: 380px;
    margin-left: 12px;
}

.xk-cc-preview {
    flex-grow: 1;
    width: 380px;
    margin-left: 0;
    justify-content: space-between;
}

.xk-cc-placeholder {
    margin-top: 8px;
    padding: 2px 8px;
    font-size: 11px;
    border-radius: 3px;
    background-color: rgba(150, 118, 52, 0.85);
    color: rgb(250, 240, 220);
}

.xk-cc-summary {
    margin-top: 8px;
    padding: 8px 10px;
    white-space: normal;
    background-color: rgba(34, 31, 26, 0.85);
    border-radius: 4px;
    color: rgb(226, 214, 190);
}

.xk-cc-foot {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: rgba(201, 164, 101, 0.3);
}

.xk-cc-problems {
    white-space: normal;
    color: rgb(170, 210, 150);
    margin-right: 10px;
}

.xk-cc-split {
    flex-direction: row;
}

.xk-cc-picker {
    width: 200px;
    margin-right: 12px;
}

.xk-cc-pick {
    height: 30px;
    margin: 2px 0;
    -unity-text-align: middle-left;
    padding-left: 10px;
}

.xk-cc-pick--on {
    background-color: rgba(120, 92, 48, 0.95);
    border-color: rgba(240, 214, 160, 0.8);
    -unity-font-style: bold;
}

.xk-cc-detail {
    flex-grow: 1;
    flex-basis: 0;
}

.xk-cc-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
    white-space: normal;
}

.xk-cc-source {
    font-size: 11px;
    color: rgb(150, 142, 126);
    margin-bottom: 4px;
}

.xk-cc-warn {
    white-space: normal;
    font-size: 12px;
    padding: 4px 8px;
    margin: 4px 0;
    border-radius: 3px;
    background-color: rgba(120, 90, 40, 0.45);
    color: rgb(240, 214, 160);
}

.xk-cc-col {
    width: 110px;
}

.xk-cc-choice {
    margin-top: 8px;
}

.xk-cc-wrap {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
}

.xk-cc-banner {
    padding: 10px 12px;
    margin-bottom: 10px;
    border-radius: 6px;
    background-color: rgba(120, 92, 48, 0.35);
    border-width: 1px;
    border-color: rgba(214, 180, 116, 0.5);
}

.xk-cc-card {
    width: 120px;
    margin: 0 8px 8px 0;
    padding: 8px;
    align-items: center;
    border-radius: 6px;
    background-color: rgba(44, 40, 33, 0.95);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.35);
}

.xk-cc-card-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-cc-card-label {
    font-size: 11px;
    color: rgb(190, 181, 163);
}

/* Phase 7: experience bar */
.xk-xp-track {
    height: 10px;
    margin-top: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.45);
}

.xk-xp-fill {
    height: 100%;
    background-color: rgb(201, 164, 101);
    border-radius: 4px;
}

/* Phase 7: key/value rows wrap instead of overflowing */
.xk-w-pair > .xk-w-key {
    white-space: normal;
    flex-shrink: 0;
}

.xk-w-pair > .xk-w-value {
    flex-basis: 0;
    flex-shrink: 1;
}

/* ----- Phase 8: the encounter panel ------------------------------------------------------------ */

.xk-combat {
    left: 1.5%;
    right: 1.5%;
    bottom: 1.5%;
    height: 47%;
    padding: 10px 14px;
    background-color: rgba(18, 16, 13, 0.94);
}

.xk-combat-turn {
    font-size: 16px;
    -unity-font-style: bold;
    margin: 0 12px;
    color: rgb(214, 205, 186);
}

.xk-combat-turn--yours {
    color: rgb(240, 200, 110);
}

.xk-combat-head-button {
    margin-left: 6px;
}

.xk-combat-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.xk-combat-col {
    flex-direction: column;
    margin-right: 10px;
    min-height: 0;
}

.xk-combat-col--order {
    width: 19%;
}

.xk-combat-col--grid {
    width: 24%;
}

.xk-combat-col--actions {
    width: 20%;
}

.xk-combat-col--info {
    width: 19%;
}

.xk-combat-col--log {
    flex-grow: 1;
    margin-right: 0;
}

.xk-combat-row {
    -unity-text-align: middle-left;
    white-space: normal;
    font-size: 12px;
    margin: 1px 0;
    padding: 3px 6px;
    background-color: rgba(40, 36, 30, 0.9);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.15);
    border-radius: 4px;
    color: rgb(232, 223, 204);
}

.xk-combat-row--active {
    border-color: rgb(240, 200, 110);
    background-color: rgba(70, 58, 34, 0.95);
}

.xk-combat-row--selected {
    border-left-width: 4px;
}

.xk-combat-row--down {
    color: rgb(150, 142, 126);
}

.xk-combat-grid-row {
    flex-direction: row;
}

.xk-combat-cell {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(201, 164, 101, 0.12);
    background-color: rgba(48, 44, 36, 0.85);
    color: rgb(240, 236, 226);
}

.xk-combat-cell--reachable {
    background-color: rgba(60, 96, 58, 0.85);
}

.xk-combat-cell--reachable:hover {
    background-color: rgba(86, 140, 80, 0.95);
}

.xk-combat-cell--difficult {
    background-color: rgba(92, 74, 46, 0.9);
}

.xk-combat-cell.xk-combat--player {
    background-color: rgb(52, 98, 170);
}

.xk-combat-cell.xk-combat--ally {
    background-color: rgb(48, 120, 62);
}

.xk-combat-cell.xk-combat--enemy {
    background-color: rgb(150, 44, 36);
}

.xk-combat-cell--active {
    border-color: rgb(240, 200, 110);
    border-width: 2px;
}

.xk-combat-cell--down {
    opacity: 0.55;
}

.xk-combat-economy {
    font-size: 12px;
    color: rgb(214, 205, 186);
    margin-bottom: 4px;
    white-space: normal;
}

.xk-combat-option {
    margin-bottom: 2px;
}

.xk-combat-act {
    -unity-text-align: middle-left;
    white-space: normal;
    font-size: 12px;
    margin: 0;
}

.xk-combat-why {
    font-size: 11px;
    color: rgb(200, 160, 100);
    white-space: normal;
    margin: 0 0 2px 8px;
}

.xk-combat-result {
    font-size: 12px;
    white-space: normal;
    color: rgb(240, 230, 205);
    background-color: rgba(40, 36, 30, 0.9);
    padding: 6px;
    border-radius: 4px;
    margin-bottom: 6px;
}

.xk-combat-inspector {
    flex-grow: 1;
}

.xk-combat-inspect-line {
    font-size: 11px;
    white-space: normal;
    color: rgb(214, 205, 186);
    margin-bottom: 2px;
}

.xk-combat-log {
    flex-grow: 1;
}

.xk-combat-log-line {
    font-size: 11px;
    white-space: normal;
    color: rgb(214, 205, 186);
    margin-bottom: 1px;
}

.xk-combat-log--attack {
    color: rgb(236, 216, 170);
}

.xk-combat-log--damage {
    color: rgb(240, 160, 130);
}

.xk-combat-log--downed,
.xk-combat-log--died {
    color: rgb(240, 110, 90);
    -unity-font-style: bold;
}

.xk-combat-log--turnstarted {
    color: rgb(160, 152, 136);
}

.xk-combat-log--ended {
    color: rgb(240, 200, 110);
    -unity-font-style: bold;
}

/* ----- Phase 9: spells and features -------------------------------------------------------------- */

.xk-combat-fold {
    margin-bottom: 4px;
}

.xk-combat-fold > .unity-foldout__toggle {
    color: rgb(240, 200, 110);
    -unity-font-style: bold;
    font-size: 12px;
    margin: 2px 0;
}

.xk-combat-fold > .unity-foldout__content {
    margin-left: 4px;
}

.xk-combat-feature-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
}

.xk-combat-feature-row > .xk-button {
    font-size: 11px;
    margin: 1px 2px 1px 0;
}

.xk-combat-cell--area {
    background-color: rgba(190, 120, 40, 0.75);
}

.xk-sp-slots {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
}

.xk-sp-slot {
    font-size: 13px;
    margin-right: 18px;
    color: rgb(240, 220, 170);
}

.xk-sp-search {
    width: 180px;
    margin-right: 8px;
}

.xk-sp-list {
    margin: 4px 0;
}

.xk-sp-row {
    -unity-text-align: middle-left;
    white-space: normal;
    font-size: 12px;
    margin: 1px 0;
    padding: 3px 6px;
    background-color: rgba(40, 36, 30, 0.9);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.15);
    border-radius: 4px;
    color: rgb(232, 223, 204);
}

.xk-sp-row:hover {
    background-color: rgba(60, 52, 40, 0.95);
}

.xk-sp-row--selected {
    border-color: rgb(240, 200, 110);
}

.xk-sp-row--inactive {
    color: rgb(150, 142, 126);
}

.xk-sp-detail {
    margin: 6px 0;
    padding: 8px;
    background-color: rgba(30, 27, 22, 0.95);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.35);
    border-radius: 6px;
}

/* Phase 9: the spell stats sit side by side; each value keeps its width */
#xk-sp-stats > .xk-w-pair {
    margin-right: 28px;
}

#xk-sp-stats > .xk-w-pair > .xk-w-key {
    width: auto;
    margin-right: 8px;
}

#xk-sp-stats > .xk-w-pair > .xk-w-value {
    flex-basis: auto;
    flex-shrink: 0;
}

.xk-sp-search .unity-base-text-field__input {
    background-color: rgb(40, 34, 28);
    color: rgb(240, 225, 190);
    border-color: rgb(120, 96, 60);
}

.xk-combat-aim-hint {
    white-space: normal;
    color: rgb(214, 180, 116);
    -unity-font-style: bold;
}

/* Phase 10: a reaction or decision waiting on the player — above every column of the encounter panel. */
.xk-combat-prompt {
    flex-direction: row;
    align-items: center;
    margin: 4px 6px;
    padding: 8px 10px;
    background-color: rgba(92, 64, 24, 0.97);
    border-width: 2px;
    border-color: rgb(240, 200, 110);
    border-radius: 4px;
}

.xk-combat-prompt-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(250, 225, 160);
}

.xk-combat-prompt-body {
    font-size: 12px;
    white-space: normal;
    color: rgb(240, 230, 205);
}

.xk-combat-prompt .xk-button {
    margin-left: 8px;
    min-width: 110px;
}

/* ----- Phase 11: items (ADR-0055) ----- */
.xk-inv-load { align-items: center; margin-bottom: 2px; }
.xk-inv-bar { width: 160px; height: 8px; margin-right: 8px; background-color: rgba(255, 255, 255, 0.10); border-radius: 4px; overflow: hidden; }
.xk-inv-bar-fill { height: 100%; background-color: rgb(196, 168, 102); }
.xk-inv-bar-fill--over { background-color: rgb(200, 92, 64); }
.xk-inv-tools { align-items: center; flex-wrap: wrap; margin: 4px 0 2px 0; }
.xk-inv-search { width: 180px; margin-right: 4px; }
.xk-inv-groups { flex-wrap: wrap; margin-bottom: 6px; }
.xk-inv-item { margin-bottom: 2px; }
.xk-inv-magic { color: rgb(150, 182, 236); }
.xk-inv-details { padding: 8px; margin: 4px 0 8px 0; background-color: rgba(0, 0, 0, 0.30); border-width: 1px; border-color: rgba(196, 168, 102, 0.45); border-radius: 4px; }
.xk-inv-warning { color: rgb(232, 128, 96); white-space: normal; margin: 2px 0; }
.xk-inv-compare { margin-top: 6px; padding-top: 4px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.12); }
.xk-inv-delta { width: 56px; -unity-text-align: middle-right; color: rgb(170, 170, 160); }
.xk-inv-delta--up { color: rgb(126, 196, 112); }
.xk-inv-delta--down { color: rgb(220, 110, 90); }
.xk-store { padding: 6px; margin-bottom: 8px; background-color: rgba(0, 0, 0, 0.22); border-radius: 4px; }

/* ----- Phase 12: dialogue and journal ----- */
.xk-dialogue { position: absolute; left: 22%; right: 22%; bottom: 7%; max-height: 62%; padding: 14px 18px; }
.xk-dialogue-quest { color: rgb(214, 188, 120); margin: 2px 0 6px 0; }
.xk-dialogue-transcript { max-height: 160px; margin-bottom: 6px; }
.xk-dialogue-said { color: rgb(170, 164, 150); white-space: normal; margin: 1px 0; }
.xk-dialogue-check { color: rgb(150, 182, 236); font-size: 12px; margin: 1px 0 3px 0; }
.xk-dialogue-line { color: rgb(240, 232, 212); font-size: 17px; white-space: normal; margin: 6px 0 10px 0; }
.xk-dialogue-responses { margin-bottom: 4px; }
.xk-dialogue-response { -unity-text-align: middle-left; white-space: normal; margin: 2px 0; padding: 5px 10px; }
.xk-dialogue-response--quest { border-left-width: 3px; border-color: rgb(214, 188, 120); }
.xk-dialogue-response--social { color: rgb(170, 200, 240); }
.xk-journal-objective { white-space: normal; margin: 2px 0 2px 6px; }
.xk-journal-objective--done { color: rgb(126, 196, 112); }
.xk-journal-objective--locked { color: rgb(130, 126, 116); }
.xk-tracked { position: absolute; right: 18px; top: 74px; max-width: 420px; padding: 8px 12px; background-color: rgba(18, 16, 12, 0.72); border-radius: 4px; color: rgb(236, 222, 186); white-space: normal; -unity-text-align: upper-left; }

/* ----- Phase 13: places ----- */
.xk-combat-cell--wall { background-color: rgba(24, 22, 20, 0.95); }
.xk-combat-cell--door { background-color: rgba(96, 62, 30, 0.95); border-color: rgb(150, 105, 55); }
.xk-combat-cell--door-open { background-color: rgba(96, 62, 30, 0.35); border-color: rgb(150, 105, 55); }
.xk-combat-cell--cover { background-color: rgba(120, 110, 80, 0.55); border-bottom-width: 3px; border-bottom-color: rgb(170, 150, 100); }
.xk-combat-cell--hidden { opacity: 0.45; }
.xk-place { position: absolute; left: 18px; bottom: 120px; max-width: 460px; padding: 8px 12px; background-color: rgba(18, 16, 12, 0.72); border-radius: 4px; }
.xk-place-name { color: rgb(236, 222, 186); font-size: 18px; -unity-font-style: bold; }
.xk-place-where { color: rgb(214, 200, 168); font-size: 14px; }
.xk-place-status { color: rgb(226, 170, 110); font-size: 13px; white-space: normal; }
.xk-place-hint { color: rgb(170, 160, 136); font-size: 12px; }
.xk-place-map { position: absolute; right: 24px; top: 120px; width: 420px; padding: 10px; background-color: rgba(14, 12, 10, 0.9); border-radius: 6px; border-width: 1px; border-color: rgb(110, 92, 60); }
.xk-place-map-title { color: rgb(236, 222, 186); font-size: 16px; -unity-font-style: bold; margin-bottom: 6px; }
.xk-place-map-floor { color: rgb(200, 186, 150); font-size: 13px; margin-top: 4px; }
.xk-place-map-canvas { position: relative; height: 260px; margin-top: 4px; background-color: rgba(30, 26, 20, 0.9); }
.xk-place-map-room { position: absolute; background-color: rgba(150, 128, 92, 0.85); border-width: 1px; border-color: rgb(60, 48, 32); }
.xk-place-map-room--here { background-color: rgba(214, 170, 92, 0.95); }
.xk-place-map-room--secret { background-color: rgba(120, 96, 150, 0.85); }
.xk-place-map-passage { position: absolute; background-color: rgba(110, 96, 70, 0.85); }
.xk-place-map-legend { color: rgb(170, 160, 136); font-size: 11px; margin-top: 6px; white-space: normal; }

/* Phase 14 (ADR-0068 … ADR-0070): lasting conditions, followers, where you can rest. */
.xk-conditions { position: absolute; left: 18px; top: 150px; max-width: 360px; padding: 6px 10px; background-color: rgba(30, 14, 12, 0.78); border-radius: 4px; border-left-width: 3px; border-left-color: rgb(196, 92, 60); }
.xk-condition-name { color: rgb(246, 196, 150); font-size: 14px; -unity-font-style: bold; }
.xk-condition-effect { color: rgb(226, 214, 190); font-size: 12px; white-space: normal; }
.xk-condition-end { color: rgb(184, 172, 150); font-size: 11px; white-space: normal; -unity-font-style: italic; margin-bottom: 4px; }
.xk-condition-button { font-size: 12px; margin: 2px 0 4px 0; padding: 2px 8px; background-color: rgb(92, 52, 38); color: rgb(246, 226, 196); border-width: 0; border-radius: 3px; align-self: flex-start; }
.xk-followers { color: rgb(196, 214, 170); font-size: 12px; white-space: normal; margin-top: 4px; }
.xk-rest { color: rgb(170, 186, 200); font-size: 12px; white-space: normal; margin-top: 2px; }
.xk-place-map-bridge { position: absolute; background-color: rgba(176, 140, 82, 0.95); }
.xk-place-map-bridge--damaged { background-color: rgba(214, 160, 70, 0.95); border-width: 1px; border-color: rgb(196, 80, 50); }
.xk-place-map-bridge--destroyed { background-color: rgba(60, 40, 30, 0.6); border-width: 1px; border-color: rgb(196, 60, 40); }
.xk-place-map-fire { position: absolute; background-color: rgba(230, 110, 40, 0.55); }

/* ----- Combat Overhaul: the compact combat HUD (pieces over a clear battlefield) ----- */
.xk-combat.xk-cbt {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    height: auto;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.xk-cbt-top {
    position: absolute;
    top: 8px;
    left: 30%;
    right: 30%;
    max-height: 132px;
    padding: 6px 10px;
    border-radius: 8px;
    background-color: rgba(18, 16, 13, 0.82);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.4);
}

.xk-cbt-head {
    margin-bottom: 4px;
}

.xk-cbt-head .xk-w-title {
    font-size: 15px;
}

.xk-cbt-head .xk-w-subtitle {
    font-size: 11px;
}

.xk-cbt-order {
    max-height: 64px;
}

.xk-cbt-order .unity-scroll-view__content-container {
    flex-direction: row;
}

.xk-cbt-order .xk-combat-row {
    width: 118px;
    min-width: 118px;
    margin: 0 4px 0 0;
    padding: 3px 6px;
    font-size: 11px;
    white-space: normal;
}

.xk-cbt-card {
    position: absolute;
    left: 12px;
    bottom: 12px;
    width: 300px;
    max-height: 46%;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: rgba(18, 16, 13, 0.85);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.4);
}

.xk-cbt-card-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-cbt-hp {
    height: 8px;
    margin: 4px 0;
    border-radius: 4px;
    background-color: rgba(70, 30, 26, 0.9);
}

.xk-cbt-hp-fill {
    height: 100%;
    border-radius: 4px;
    background-color: rgb(96, 168, 92);
}

.xk-cbt-hp-fill--low {
    background-color: rgb(206, 92, 62);
}

.xk-cbt-card-line {
    font-size: 12px;
    white-space: normal;
}

.xk-cbt-card .xk-combat-result {
    font-size: 11px;
    max-height: 64px;
    overflow: hidden;
    margin-top: 4px;
}

.xk-cbt-card .xk-combat-inspector {
    max-height: 180px;
}

.xk-cbt-small {
    font-size: 11px;
    padding: 1px 8px;
    margin: 2px 0;
    align-self: flex-start;
}

.xk-cbt-bar {
    position: absolute;
    bottom: 12px;
    left: 26%;
    right: 26%;
    flex-direction: column;
    align-items: center;
    padding: 6px 10px;
    border-radius: 8px;
    background-color: rgba(18, 16, 13, 0.85);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.45);
}

.xk-cbt-slots,
.xk-cbt-groups,
.xk-cbt-ends {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.xk-cbt-slot {
    padding: 2px 10px;
    margin: 2px 3px;
    border-radius: 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(20, 18, 14);
}

.xk-cbt-slot--action { background-color: rgb(118, 186, 108); }
.xk-cbt-slot--bonus { background-color: rgb(232, 168, 72); }
.xk-cbt-slot--reaction { background-color: rgb(150, 140, 220); }

.xk-cbt-slot--used {
    background-color: rgba(90, 84, 74, 0.7);
    color: rgb(170, 160, 140);
}

.xk-cbt-move {
    margin-left: 10px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(240, 214, 160);
}

.xk-cbt-group {
    margin: 3px;
    min-width: 92px;
}

.xk-cbt-group--open {
    border-color: rgb(240, 200, 110);
    background-color: rgba(96, 74, 38, 0.95);
}

.xk-cbt-pop {
    position: absolute;
    bottom: 128px;
    left: 30%;
    right: 30%;
    max-height: 42%;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: rgba(18, 16, 13, 0.92);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.5);
}

.xk-cbt-log {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 340px;
    height: 128px;
    padding: 6px 10px;
    border-radius: 8px;
    background-color: rgba(18, 16, 13, 0.8);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.35);
}

.xk-cbt-log--open {
    height: 46%;
    width: 440px;
}

.xk-cbt-log-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.xk-cbt-log .xk-combat-log {
    flex-grow: 1;
}

.xk-cbt-log .xk-combat-log-line {
    font-size: 11px;
}

.xk-cbt-grid-panel {
    position: absolute;
    right: 12px;
    top: 150px;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: rgba(18, 16, 13, 0.9);
    border-width: 1px;
    border-color: rgba(201, 164, 101, 0.45);
}

.xk-cbt-hover {
    position: absolute;
    max-width: 300px;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 12px;
    white-space: normal;
    background-color: rgba(18, 16, 13, 0.9);
    border-width: 1px;
    border-color: rgba(118, 186, 108, 0.8);
    color: rgb(232, 223, 204);
}

.xk-cbt-hover--bad {
    border-color: rgba(206, 92, 62, 0.9);
}

.xk-cbt-confirm {
    position: absolute;
    left: 35%;
    right: 35%;
    top: 38%;
    padding: 12px 14px;
    border-radius: 8px;
    background-color: rgba(18, 16, 13, 0.96);
    border-width: 1px;
    border-color: rgb(232, 168, 72);
}

.xk-cbt-confirm-text {
    white-space: normal;
    margin-bottom: 8px;
}

.xk-cbt-confirm-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.xk-cbt .xk-combat-prompt {
    position: absolute;
    left: 30%;
    right: 30%;
    bottom: 140px;
}

/* ----- Phase 15: the party (HUD strip, hub section, combat marks) ----- */
.xk-party { position: absolute; left: 18px; bottom: 96px; width: 250px; padding: 4px 6px; background-color: rgba(16, 22, 18, 0.72); border-radius: 4px; border-left-width: 3px; border-left-color: rgb(118, 168, 104); }
.xk-party-row { flex-direction: column; align-items: stretch; margin: 2px 0; padding: 3px 6px; background-color: rgba(40, 52, 40, 0.55); border-width: 0; border-radius: 3px; }
.xk-party-row:hover { background-color: rgba(70, 92, 66, 0.75); }
.xk-party-row--reserve { opacity: 0.6; }
.xk-party-name { color: rgb(232, 236, 214); font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-left; }
.xk-party-hp { height: 5px; margin: 2px 0; background-color: rgba(0, 0, 0, 0.5); border-radius: 2px; }
.xk-party-hp-fill { height: 5px; background-color: rgb(112, 178, 92); border-radius: 2px; }
.xk-party-hp-fill--low { background-color: rgb(206, 84, 60); }
.xk-party-info { color: rgb(196, 204, 182); font-size: 11px; -unity-text-align: middle-left; }
.xk-party-card { margin: 4px 0; padding: 6px 8px; background-color: rgba(255, 255, 255, 0.04); border-radius: 4px; border-left-width: 3px; border-left-color: rgba(118, 168, 104, 0.5); }
.xk-party-card--selected { border-left-color: rgb(214, 186, 112); background-color: rgba(255, 240, 200, 0.07); }
.xk-party-detail { margin-top: 10px; padding: 8px; background-color: rgba(0, 0, 0, 0.18); border-radius: 4px; }
.xk-combat-log--reason { color: rgb(160, 204, 150); -unity-font-style: italic; font-size: 11px; }
