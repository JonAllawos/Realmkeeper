* text=auto eol=lf

*.cs      text eol=lf diff=csharp
*.asmdef  text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.uss     text eol=lf
*.uxml    text eol=lf
*.shader  text eol=lf
